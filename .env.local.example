# Supabase connection. Copy this file to .env.local.
#
# These defaults point at the local stack started by `supabase start` and use the
# Supabase CLI's fixed local-development anon key (the same on every machine, not a secret).
# For a hosted project, use the Project URL and anon public key from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
